# Cross-device sync (REQUIRED for admin to see other-device users/scores).
# 1. Create free project at https://supabase.com -> SQL editor -> paste supabase/schema.sql -> Run.
# 2. Project Settings -> API -> copy URL + anon public key below.
# 3. Local: copy this file to .env and fill values, then npm run dev.
# 4. Vercel: Project -> Settings -> Environment Variables -> add both -> Redeploy.
# Without these, app works single-browser only (localStorage dh_db_v1).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Never expose service-role or Stripe secrets in frontend code.
# Stripe (test mode, server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
